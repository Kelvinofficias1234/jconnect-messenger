{
  "name": "CallSignal",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string",
      "description": "Unique call session id"
    },
    "from_user_id": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "offer",
        "answer",
        "ice",
        "end",
        "reject",
        "busy",
        "ringing"
      ]
    },
    "call_type": {
      "type": "string",
      "enum": [
        "voice",
        "video"
      ],
      "default": "voice"
    },
    "payload": {
      "type": "string",
      "description": "JSON-encoded SDP or ICE candidate"
    }
  },
  "required": [
    "call_id",
    "from_user_id",
    "to_user_id",
    "signal_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}