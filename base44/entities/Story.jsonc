{
  "name": "Story",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "image"
      ],
      "default": "text"
    },
    "content": {
      "type": "string",
      "description": "Text content or image URL"
    },
    "background_color": {
      "type": "string",
      "default": "#0d9488"
    },
    "viewed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs who viewed"
    },
    "posted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Explicit UTC ISO timestamp of when the status was posted"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "type",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}