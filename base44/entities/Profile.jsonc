{
  "name": "Profile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User id"
    },
    "display_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "status_message": {
      "type": "string"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number with country code, e.g. +250788123456"
    },
    "username": {
      "type": "string",
      "unique": true,
      "description": "Unique @username handle (3-32 chars, alphanumeric + underscores). Enables lookup without sharing phone number."
    },
    "public_key": {
      "type": "string",
      "description": "ECDH P-256 public key (base64) for end-to-end encryption. The matching private key never leaves the user's device."
    },
    "is_meta_verified": {
      "type": "boolean",
      "default": false
    },
    "verified_tier": {
      "type": "string",
      "enum": [
        "none",
        "plus",
        "premium",
        "max"
      ],
      "default": "none",
      "description": "Meta Verified subscription tier. 'none' = not subscribed, 'plus' = Business Plus, 'premium' = Business Premium, 'max' = Business Max"
    },
    "broadcast_limit": {
      "type": "number",
      "default": 0,
      "description": "Monthly business broadcast delivered-messages limit (0/1000/2500/10000)"
    },
    "protected_accounts_limit": {
      "type": "number",
      "default": 0,
      "description": "Number of protected business accounts included (0 for Plus, 10 for Premium, 50 for Max)"
    },
    "verified_channel_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Can create and own a Verified channel (Business Plus and above)"
    },
    "active_case_monitoring": {
      "type": "boolean",
      "default": false,
      "description": "Active case monitoring on support tickets (Business Max only)"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "free"
      ],
      "default": "none",
      "description": "none = no subscription, active = paid subscription, free = granted free by app owner"
    },
    "subscription_amount": {
      "type": "number",
      "default": 0,
      "description": "Monthly amount paid (0 if granted free by owner)"
    },
    "blocked_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "chat_background": {
      "type": "string",
      "default": "default"
    },
    "app_background": {
      "type": "string",
      "default": "#1A002C",
      "description": "Global app background theme color (hex). Does not affect chat screens \u2014 those use chat_background."
    },
    "ringtone": {
      "type": "string",
      "default": "j_connect_call"
    },
    "notification_sound": {
      "type": "string",
      "default": "nt_pulse"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "read_receipts_enabled": {
      "type": "boolean",
      "default": true
    },
    "emergency_contact_id": {
      "type": "string",
      "description": "User ID of nominated emergency contact"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Display name of emergency contact for fast rendering"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "default": "light"
    },
    "backup_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether auto backup is enabled"
    },
    "backup_consent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the user accepted or declined backup (null = not yet prompted)"
    },
    "last_backup_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent automatic backup heartbeat"
    }
  },
  "required": [
    "user_id",
    "display_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}