{
  "name": "Product",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string",
      "description": "User ID of the seller"
    },
    "seller_name": {
      "type": "string",
      "description": "Display name of seller for fast rendering"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Price in the given currency"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "ISO currency code, e.g. USD, RWF, EUR"
    },
    "image_url": {
      "type": "string",
      "description": "Primary product image URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "electronics",
        "fashion",
        "home",
        "beauty",
        "sports",
        "toys",
        "food",
        "other"
      ],
      "default": "other"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "good",
        "fair"
      ],
      "default": "new"
    },
    "location": {
      "type": "string",
      "description": "Seller location or pickup area"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "removed"
      ],
      "default": "active"
    }
  },
  "required": [
    "seller_id",
    "title",
    "price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}