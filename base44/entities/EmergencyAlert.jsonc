{
  "name": "EmergencyAlert",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "police",
        "ambulance",
        "fire"
      ]
    },
    "country": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "location_shared": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "service_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}